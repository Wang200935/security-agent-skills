# ===== 暗網研究硬化 torrc — Hermes 2026-07-19 =====

# --- SOCKS (每個目標獨立 circuit) ---
SocksPort 127.0.0.1:9050 IsolateDestAddr IsolateDestPort KeepAliveIsolateSOCKSAuth
DNSPort 127.0.0.1:9053 IsolateDestAddr

# --- 控制埠 (Cookie) ---
ControlPort 127.0.0.1:9051
CookieAuthentication 1
DataDirectory /Users/wang/homebrew/var/lib/tor

# --- 時間/重試 ---
CircuitBuildTimeout 60
KeepalivePeriod 60
NewCircuitPeriod 30
MaxCircuitDirtiness 600

# --- 節點選擇 ---
# 避開五眼 (US/CA/UK/AU/NZ) + 台灣 (避免回家 ISP) + 高風險/審查國
StrictNodes 1
ExitNodes {nl},{de},{ch},{se},{ro},{is},{fi},{no},{fr},{be},{at}
ExcludeNodes {us},{ca},{gb},{au},{nz},{tw},{cn},{ru},{ir},{kp},{sa},{sy}

# --- 安全 ---
SafeLogging 1
Log notice file /Users/wang/homebrew/var/lib/tor/notices.log
Log warn  file /Users/wang/homebrew/var/lib/tor/warn.log

# --- Path bias 偵測惡意 guard/relay ---
PathBiasUseThreshold 12
PathBiasScaleThreshold 12

# --- 客戶端優先 ---
SafeSocks 0
TestSocks 0
ClientUseIPv4 1
ClientUseIPv6 0

# (註: NoExec 在 macOS 不支援, 省略)
# (註: 不用 ReachableAddresses 收緊, 因 .onion 站常在非標 port)
